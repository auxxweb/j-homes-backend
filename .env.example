PORT=4000
# MongoDB Atlas connection string. Leave empty in local development to use an in-memory database.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@jhomes.in
ADMIN_PASSWORD="123456"
ADMIN_PASSWORD_RESET=true
ADMIN_NAME=J Homes
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://www.jhomes.in,https://jhomes.in,https://admin.jhomes.in
PUBLIC_API_URL=https://server.jhomes.in
PUBLIC_SITE_URL=https://www.jhomes.in
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=j-homes
# Used by the organisation assistant. The key stays on the API and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
